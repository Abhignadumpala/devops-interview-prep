# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database Configuration
DATABASE_URL=mongodb://localhost:27017/devops-prep
POSTGRES_URL=postgresql://user:password@localhost:5432/devops

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=debug

# API Configuration
API_TIMEOUT=30000
MAX_REQUEST_SIZE=10mb

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
